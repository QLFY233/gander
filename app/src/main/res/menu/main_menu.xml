<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- The two things the title bar itself offers, at its right-hand end. Search collapses
         into a field in the bar rather than opening a screen of its own: the filter applies to
         the grid underneath, so the grid has to stay where it is. -->
    <item
        android:id="@+id/action_search"
        android:title="@string/search_files"
        app:actionViewClass="androidx.appcompat.widget.SearchView"
        app:showAsAction="always|collapseActionView" />
    <!-- One entry for both imports, which ask which they are in a dialog rather than putting
         two similar icons side by side. New folder is a third, separate action: it makes
         something inside Gander, and sharing an icon with a file picker would be a lie about
         where the folder comes from. -->
    <item
        android:id="@+id/action_import"
        android:icon="@drawable/ic_import"
        android:title="@string/import_files"
        app:showAsAction="always" />
    <!-- ifRoom rather than always, which is what lint's AlwaysShowAction asks for past two
         always actions. The effect is the one the design asks for anyway: the plus stands
         beside the import icon wherever the title bar has room for it, and only a narrow
         phone pushes it into the overflow. -->
    <item
        android:id="@+id/action_new_folder"
        android:icon="@drawable/ic_add"
        android:title="@string/new_folder"
        app:showAsAction="ifRoom" />

    <!-- Folder actions and the reader's own preferences, all of them global now that there is
         no folder to be inside: the content column is every folder at once, so sort and filter
         apply to every section. That is why neither is hidden any more, and why the menu is
         reached from the gear at the foot of the sidebar rather than from the title bar. -->
    <item
        android:id="@+id/action_sort"
        android:title="@string/sort_by"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_filter"
        android:title="@string/filter"
        app:showAsAction="never" />

    <!-- Rate on a copy Google Play installed, the only install a rating can come from.
         Any other copy gets Switch to Google Play here instead: a copy from GitHub is
         signed with the same key as Play's, so its listing offers Update and moves it
         over in place. Both open the listing; MainActivity.installedFromPlay picks the
         title. -->
    <item
        android:id="@+id/action_play"
        android:title="@string/switch_to_play"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_share_app"
        android:title="@string/share_app"
        app:showAsAction="never" />
    <item
        android:id="@+id/action_about"
        android:title="@string/about_gander"
        app:showAsAction="never" />
</menu>
