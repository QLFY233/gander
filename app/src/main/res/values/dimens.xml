<?xml version="1.0" encoding="utf-8"?>
<!--
     Sizes that more than one file has to agree on.

     The welcome block is the bulk of it: everything else on the home screen is a
     Material component at its standard size, and this block is the one thing drawn to
     fit a screen, so it is the one thing with a size per screen. values-sw600dp holds
     the tablet set.
-->
<resources>
    <!-- Matches the 48dp badge on a file row, plus a little, because these are the
         subject of the screen here rather than a marker beside a filename. -->
    <dimen name="welcome_tile_size">56dp</dimen>
    <dimen name="welcome_tile_text">14sp</dimen>
    <!-- Margin on every side, so the gap between two tiles is twice this. -->
    <dimen name="welcome_tile_gap">6dp</dimen>
    <!-- A minimum rather than a width, so a large system font size grows the button
         instead of ellipsising its label. -->
    <dimen name="welcome_action_min_width">240dp</dimen>

    <!-- Above and below a box with a field to type in, a zip file's password or a page to go
         to, in place of Material's 80dp: with the keyboard up, 80 left the field under 48dp on a
         731dp phone. The same as a dialog's inset at its sides. -->
    <dimen name="field_box_inset">24dp</dimen>

    <!-- The scroll thumb's floor, and so its height in the layout: proportional alone
         is two pixels on a 357-page document. syncFastScroll reads the same value, so
         the two cannot drift. -->
    <dimen name="fast_scroll_thumb_min">48dp</dimen>

    <!-- The sidebar. A phone gets the narrower of the two because the panel floats over the
         content there and every dp it takes is a dp of the file list behind it; a tablet
         held sideways, where the two sit side by side, gets the width the design draws. See
         values-sw600dp/dimens.xml for the other one. -->
    <dimen name="sidebar_width">280dp</dimen>

    <!-- One row of either sidebar list. Tall enough for a 24dp type icon and a name at a
         large system font size, and the same height for a folder and a file so an expanded
         folder reads as one block. -->
    <dimen name="sidebar_row_height">56dp</dimen>

    <!-- What a file row inside an expanded folder is pushed in by, so the folder that holds
         it is visibly its parent. Also the base inset of every sidebar row, which is why it is
         a resource: the adapter has to add the two together, and a literal in two places would
         drift the first time one of them moved. -->
    <dimen name="sidebar_indent">16dp</dimen>
    <dimen name="sidebar_row_inset">16dp</dimen>

    <!-- The content column's card grid. A card is never narrower than this, and the column
         count is the widest fit between two and six: see cardColumns in HomeAdapter.kt.
         168dp is three 48dp badges and the gap between them, which is the smallest a cover
         with a filename under it stays readable at. -->
    <dimen name="home_card_min_width">168dp</dimen>

    <!-- Half of the 16dp between two cards. It is a margin on the card rather than an
         ItemDecoration on the grid, because a decoration would have to add the same number
         back as padding and would double up at the edges; as a margin it also spaces the
         outermost cards from the column's own edge, which is what the grid wants anyway. -->
    <dimen name="home_card_margin">8dp</dimen>
</resources>
