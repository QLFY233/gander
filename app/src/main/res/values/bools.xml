<?xml version="1.0" encoding="utf-8"?>
<!-- Dark icons in the status bar, because the day surface is a warm near-white.

     This is a resource rather than an item in a values-night theme because a style
     redeclared under values-night replaces the day one outright instead of merging
     with it: a night Theme.Gander existing only to flip this flag would silently drop
     all thirty-five colour role mappings and put the baseline purple back. One theme,
     one qualified boolean.
-->
<resources>
    <bool name="gander_light_status_bar">true</bool>

    <!-- How the sidebar starts out, which is a question about the screen rather than about
         the reader, so it is a resource and not a constant.

         The other half of the pair lives in values-sw600dp-land/bools.xml. Smallest width
         outranks orientation in the resource table, so both qualifiers are needed to say
         "a tablet held sideways": sw600dp alone is also a tablet held upright, which has no
         room for two columns and floats the sidebar over the content like a phone. -->
    <!-- The sidebar floats over the content, with a scrim, on everything except a landscape
         tablet. See layout/activity_main.xml. -->
    <bool name="sidebar_overlays_content">true</bool>

    <!-- And starts away on those screens, because it covers the content when it is out. -->
    <bool name="sidebar_open_by_default">false</bool>
</resources>
