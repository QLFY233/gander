<?xml version="1.0" encoding="utf-8"?>
<!-- The two arrangements of the home screen.

     This one is the overlay: the sidebar floats over the content with a scrim behind it,
     which is what a phone gets in either orientation and a tablet gets held upright. A
     tablet held sideways gets layout-sw600dp-land/activity_main.xml instead, where the two
     sit side by side. Both include the same two files, so the difference is only where the
     sidebar is put; the widgets, their ids and their behaviour are written once. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/view_content" />

    <!-- Dims the content rather than moving it, and takes the tap that closes the panel. -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gander_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <include
        layout="@layout/view_sidebar"
        android:layout_width="@dimen/sidebar_width"
        android:layout_height="match_parent"
        android:layout_gravity="start" />
</FrameLayout>
