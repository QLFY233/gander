<?xml version="1.0" encoding="utf-8"?>
<!-- A heading inside the sidebar: the reading history, then the folders. Both start open and
     both fold, which is what the arrow says.

     The tap ripple is a foreground, not a background: a row that painted its own background
     would be painting over the window's, which is what lint's Overdraw is about.

     Lint would rather this row were one TextView with a compound drawable, and for a fixed
     arrow it would be right. This arrow turns a quarter at a time as the section folds, and a
     compound drawable has no rotation of its own — a RotateDrawable driven by a level would be
     one, at the price of a wrapper drawable and of turning an arrow a second way, since the
     folder rows below turn an ImageView. Hence the suppression. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sidebarHeaderRow"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    tools:ignore="UseCompoundDrawables">

    <ImageView
        android:id="@+id/sidebarHeaderChevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_down" />

    <TextView
        android:id="@+id/sidebarHeaderText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorPrimary" />
</LinearLayout>
