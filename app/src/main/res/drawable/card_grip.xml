<?xml version="1.0" encoding="utf-8"?>
<!-- The grip in the corner of a card: the dots, on a scrim of their own.

     The scrim is there because the thing underneath is a photograph. A white glyph on a bright
     cover is invisible, and a dark one is invisible on a dark cover; a translucent black disc
     with white dots on it reads on both, in either theme, without a second copy of the icon for
     night mode.

     One drawable rather than an ImageView with a background, so that the two arrive together and
     the dots cannot be drawn over by their own backdrop: a foreground would paint last, and a
     background is what the layout lints call overdraw. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <solid android:color="#73000000" />
        </shape>
    </item>

    <item
        android:drawable="@drawable/ic_drag_handle"
        android:gravity="center"
        android:width="18dp"
        android:height="18dp" />
</layer-list>
